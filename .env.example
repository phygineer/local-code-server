```dotenv
# ==============================================================================
# Local Code Server Configuration
# ==============================================================================
#
# Copy this file before starting:
#
#   cp .env.example .env
#
# Then edit .env for your machine.
#
# IMPORTANT:
# .env should NOT be committed to Git.


# ------------------------------------------------------------------------------
# Workspace
# ------------------------------------------------------------------------------
#
# Local directory that will be mounted into the container as /workspace.
#
# Claude Code and other processes inside the container will have READ/WRITE
# access to this directory.
#
# For security, mount only the project/directory you want the AI agent to access.
# Do NOT use your entire home directory.
#
# macOS example:
# WORKSPACE_PATH=/Users/yourname/Projects/my-project
#
# Linux example:
# WORKSPACE_PATH=/home/yourname/projects/my-project
#
# Relative paths also work:
# WORKSPACE_PATH=../my-project

WORKSPACE_PATH=/absolute/path/to/your/project


# ------------------------------------------------------------------------------
# code-server
# ------------------------------------------------------------------------------

# Password used to log in to the code-server web interface.
#
# Change this before use.

CODE_SERVER_PASSWORD=change-me


# Host port used to access code-server.
#
# With the default value:
#
#   http://localhost:9999

CODE_SERVER_PORT=9999


# ------------------------------------------------------------------------------
# Ollama
# ------------------------------------------------------------------------------
#
# Ollama runs on the HOST machine rather than inside this container.
#
# Docker Desktop on macOS/Windows exposes the host through:
#
#   host.docker.internal
#
# The Ollama CLI and compatible tools inside code-server will use this endpoint.

OLLAMA_HOST=http://host.docker.internal:11434
```
